storage/db/*.sqlite
storage/db/*.sqlite-*
storage/backups/*
storage/logs/*
.env
.claude/
*.zip
public/uploads/project-requests/*
!public/uploads/project-requests/.gitkeep
public/uploads/client-files/*
!public/uploads/client-files/.gitkeep

# Client sites generated by the Arch agent (kept out of git; created at runtime)
public/generated-sites/*
