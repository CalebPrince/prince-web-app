storage/db/*.sqlite
storage/db/*.sqlite-*
storage/backups/*
storage/logs/*
.env
.claude/
*.zip
public/uploads/project-requests/*
!public/uploads/project-requests/.gitkeep
public/uploads/client-files/*
!public/uploads/client-files/.gitkeep

# Invoice PDFs rendered at runtime for WhatsApp/email delivery — contain
# client billing details, kept out of git; the directory is created on demand.
public/uploads/invoices/*
!public/uploads/invoices/.gitkeep

# Client sites generated by the Arch agent (kept out of git; created at runtime)
public/generated-sites/*
!public/generated-sites/.gitkeep

# HyperFrames video authoring project — keep composition source, not rendered output
video-assets/node_modules/
video-assets/renders/
video-assets/.debug/
video-assets/assets/*
!video-assets/assets/.gitkeep

# HyperFrames/browser working data and generated delivery renders
video-assets/**/renders/
video-assets/**/.thumbnails/
videos/**/node_modules/
videos/**/.capture-profile/
videos/**/renders/
videos/**/reference/yt-dlp.exe

# Tailwind build pipeline — CI-only, compiled fresh on every deploy (see
# README.md Setup). Never commit the compiled output.
/node_modules/
/public/css/tailwind.build.css

# Playwright MCP tool's own session logs/page snapshots — scratch output
# from browser automation, not project content.
/.playwright-mcp/
